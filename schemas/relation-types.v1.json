{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-radar.local/schemas/relation-types.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "relation-types"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "directions"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "directions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["directed", "symmetric"]}
          }
        }
      }
    }
  }
}
