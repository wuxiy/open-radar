{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-radar.local/schemas/run-manifest.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "kind", "started_at", "status", "counts"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["ingest", "collect", "detect-changes", "generate", "validate"]},
    "started_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "finished_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "status": {"enum": ["started", "succeeded", "partial", "pending", "failed"]},
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "request_id": {"type": "string", "minLength": 1},
        "intake_repository_id": {"type": "string", "minLength": 1},
        "issue_number": {"type": "integer", "minimum": 1},
        "requester": {"type": "string", "minLength": 1},
        "source_url": {"type": ["string", "null"]},
        "comment_preview": {"type": ["string", "null"], "maxLength": 512},
        "comment_truncated": {"type": "boolean"}
      }
    }
  }
}
