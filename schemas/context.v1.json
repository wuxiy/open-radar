{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-radar.local/schemas/context.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "context_id", "name", "goal", "technical_questions", "priority"],
  "properties": {
    "schema_version": {"const": 1},
    "context_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "technical_questions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "priority": {"type": "integer", "minimum": 1, "maximum": 5},
    "active": {"type": "boolean"},
    "project_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "uniqueItems": true}
  }
}
