{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-radar.local/schemas/research-evidence.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_id", "project_id", "kind", "claim", "reason",
    "source_type", "source_ref", "input_version", "generated_at", "confidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_id": {"type": "string", "pattern": "^evidence-[a-z0-9][a-z0-9-]*$"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "kind": {"enum": ["fact", "inference", "opinion"]},
    "claim": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["url", "commit", "observation", "snapshot"]},
    "source_ref": {"type": "string", "minLength": 1},
    "input_version": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "dimension": {"enum": ["innovation", "engineering", "relevance", "activity", "learning_value"]},
    "rating": {"type": "number", "minimum": 0, "maximum": 10},
    "context_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "model": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"required": ["rating"]}, "then": {"required": ["dimension"]}},
    {"if": {"properties": {"dimension": {"const": "relevance"}}, "required": ["dimension"]}, "then": {"required": ["context_id"]}},
    {"if": {"properties": {"source_type": {"const": "url"}}, "required": ["source_type"]}, "then": {"properties": {"source_ref": {"pattern": "^https://"}}}},
    {"if": {"properties": {"source_type": {"const": "commit"}}, "required": ["source_type"]}, "then": {"properties": {"source_ref": {"pattern": "^[0-9a-f]{7,64}$"}}}}
  ]
}
